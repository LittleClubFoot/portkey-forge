{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema/capability.json",
  "identifier": "default",
  "description": "Default capabilities for Kids Media Manager",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "fs:default",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    "shell:default"
  ]
}
